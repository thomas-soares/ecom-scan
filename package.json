{
  "name": "ecom-scan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "ts-node-dev --respawn --transpile-only --project apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:worker": "tsx watch --tsconfig apps/scan-worker/tsconfig.json apps/scan-worker/src/main.ts",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start:api": "node apps/api/dist/main.js",
    "build:worker": "tsc -p apps/scan-worker/tsconfig.json",
    "start:worker": "node apps/scan-worker/dist/main.js",
    "dev:stack": "docker compose up -d postgres redis api worker",
    "dev:stack:logs": "docker compose logs -f api worker",
    "dev:stack:down": "docker compose down",
    "dev:stack:reset": "docker compose down -v",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@prisma/client": "^6.13.0",
    "better-auth": "^1.3.4",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.7.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "playwright": "^1.55.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.13.0",
    "tailwindcss": "^4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
